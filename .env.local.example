NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-side market provider configuration.
# Keep API_FOOTBALL_KEY private and never expose it via NEXT_PUBLIC_ variables.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
MARKET_DATA_PROVIDER=api-football

# Target league/season configuration for discovery and dry-run squad import.
# MARKET_TARGET_SEASON expects the numeric starting season year (2026 for 2026/27).
# If omitted, Sprint 7A defaults MARKET_TARGET_SEASON to 2026.
MARKET_TARGET_LEAGUE_ID=39
MARKET_TARGET_SEASON=2026

# Optional admin controls used by protected server routes.
MARKET_ADMIN_SECRET=set_a_strong_server_only_secret
MARKET_ADMIN_USER_IDS=comma,separated,supabase_user_ids
